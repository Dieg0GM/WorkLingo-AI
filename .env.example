# =============================================================================
# WorkLingo AI - Environment variables template
# =============================================================================
# 1. Copy this file to `.env`  (cp .env.example .env  on macOS/Linux)
# 2. Fill in the API keys for the providers you want to use.
# 3. All provider keys are OPTIONAL - providers without a key are skipped
#    automatically and the UI shows them with a "missing key" badge.
# 4. NEVER commit your real `.env` file. It is already in .gitignore.
# =============================================================================


# -----------------------------------------------------------------------------
# Server (optional - defaults are fine for local development)
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins for CORS.
# CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
#
# Logging level: debug | info | warning | error
# LOG_LEVEL=info


# -----------------------------------------------------------------------------
# Provider API keys
# -----------------------------------------------------------------------------

# Gemini (Google AI Studio) — used by backend/providers/gemini.py
# Get a key at:    https://aistudio.google.com/apikey
# Free tier with daily request/minute limits. Format: AIzaSy...
GEMINI_API_KEY=

# OpenRouter — used by backend/providers/openrouter.py
# Get a key at:    https://openrouter.ai/keys
# One key gives access to many models. Use ":free" suffix for free models
# (e.g. "meta-llama/llama-3.3-70b:free").
OPENROUTER_API_KEY=

# Groq — used by backend/providers/groq.py
# Get a key at:    https://console.groq.com/keys
# Free tier with very fast inference (Groq LPU).
GROQ_API_KEY=

# DeepSeek — used by backend/providers/deepseek.py
# Get a key at:    https://platform.deepseek.com/api_keys
# Free credits on signup. deepseek-chat (V3) is the main model.
DEEPSEEK_API_KEY=

# Kimi (Moonshot) — used by backend/providers/kimi.py
# Get a key at:    https://platform.kimi.ai/console/api-keys
# Free credits, OpenAI-compatible API. kimi-k3 is the flagship model.
MOONSHOT_API_KEY=

# Ollama — local LLM runner, no API key required.
# Only override OLLAMA_BASE_URL if Ollama is running on a non-default
# host/port. Install Ollama from https://ollama.com/download.
# OLLAMA_BASE_URL=http://localhost:11434
